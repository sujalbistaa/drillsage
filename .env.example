# Copy to .env and adjust. Every variable the system reads is documented here.

# --- Runtime -----------------------------------------------------------------
DRILLSAGE_ENVIRONMENT=development          # development | test | production
DRILLSAGE_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
DRILLSAGE_LOG_JSON=false                   # true in production (structured JSON logs)
DRILLSAGE_CORS_ORIGINS=["http://localhost:3000"]

# --- Database (docker compose exposes Postgres on 5433 to avoid clashing with a local 5432) ---
DRILLSAGE_DATABASE_URL=postgresql+asyncpg://drillsage:drillsage@localhost:5433/drillsage
POSTGRES_USER=drillsage
POSTGRES_PASSWORD=drillsage
POSTGRES_DB=drillsage

# --- Data (Phase 1) ---------------------------------------------------------------
# DRILLSAGE_DATA_DIR=/abs/path/to/data     # default: <repo>/data (raw/, interim/, processed/)
DRILLSAGE_BASIN_PACK=north_sea             # north_sea | assam_arakan (formation dictionary)

# --- LLM (Phase 2+) -------------------------------------------------------------
# The Anthropic SDK resolves ANTHROPIC_API_KEY, then an `ant auth login` profile.
ANTHROPIC_API_KEY=
DRILLSAGE_LOCAL_ONLY=false                 # true = never call a remote model (fails closed)
DRILLSAGE_LLM_BUDGET_USD=25                # hard cap across all LLM calls
DRILLSAGE_LLM_PROVIDER=gemini              # gemini (free AI Studio key, demo) | anthropic
GEMINI_API_KEY=                            # Google AI Studio key; keep it in .env only
DRILLSAGE_LLM_MODEL_EXTRACT=gemini-3.8-flash   # claude-opus-5 when provider=anthropic
DRILLSAGE_LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite","gemini-flash-lite-latest"]
DRILLSAGE_LLM_MIN_INTERVAL_S=6             # pause between calls (free-tier rate limits)
DRILLSAGE_LLM_EFFORT_EXTRACT=medium        # low | medium | high | xhigh | max
DRILLSAGE_LLM_MAX_TOKENS_EXTRACT=16000
DRILLSAGE_LLM_REFUSAL_FALLBACK=true        # server-side fallback model if a request is declined

# --- Web -----------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
